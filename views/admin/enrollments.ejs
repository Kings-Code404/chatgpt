<%- include('../partials/head', { title: 'Enrollments Management – Smart Learning' }) %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>

<main class="slw-content">
  <%- include('../partials/flash') %>

  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
      <h1 class="page-title">Enrollments Management</h1>
      <div class="page-subtitle mb-0">Roster of student course enrollments and registrations.</div>
    </div>
  </div>

  <% if (enrollments && enrollments.length > 0) { %>
    <div class="card-slw overflow-hidden">
      <div class="table-responsive">
        <table class="table-slw">
          <thead>
            <tr>
              <th>Student Name</th>
              <th>Student Email</th>
              <th>Course</th>
              <th>Enrolled Date</th>
              <th>Status</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% enrollments.forEach(en => { %>
              <tr>
                <td class="fw-semibold"><%= en.student_name %></td>
                <td class="small text-muted"><%= en.student_email %></td>
                <td>
                  <span class="badge-slw badge-primary"><%= en.course_code %></span>
                  <span class="fw-semibold ms-1"><%= en.course_title %></span>
                </td>
                <td class="small text-muted"><%= new Date(en.enrolled_at).toLocaleDateString() %></td>
                <td>
                  <span class="badge-slw badge-success text-capitalize"><%= en.status %></span>
                </td>
                <td class="text-end">
                  <button type="button" 
                          class="btn btn-sm btn-outline-danger py-1 px-2" 
                          data-method="delete" 
                          data-action="/admin/enrollments/<%= en.id %>"
                          data-confirm="Remove student <%= en.student_name %> from <%= en.course_code %>?"
                          title="Remove Enrollment">
                    <span class="material-symbols-outlined fs-6">person_remove</span>
                  </button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } else { %>
    <div class="card-slw p-5 text-center text-muted">
      <span class="material-symbols-outlined fs-1 mb-2">how_to_reg</span>
      <h2 class="h5">No student enrollments found</h2>
      <p class="small mb-0">Enrollments will appear here once students enroll in courses.</p>
    </div>
  <% } %>
</main>

<%- include('../partials/footer') %>
