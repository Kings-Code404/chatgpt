<%- include('../partials/head', { title: 'Create Course – Smart Learning' }) %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>

<main class="slw-content">
  <%- include('../partials/flash') %>

  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card-slw p-4 p-md-5">
        <h1 class="page-title mb-1">Create Course</h1>
        <div class="page-subtitle mb-4">Define a new academic course offering.</div>

        <form action="/admin/courses" method="POST">
          <div class="row g-3 mb-3">
            <div class="col-md-4">
              <label for="code" class="form-label">Course Code</label>
              <input type="text" class="form-control" id="code" name="code" placeholder="e.g. CS101" required>
            </div>
            <div class="col-md-8">
              <label for="title" class="form-label">Course Title</label>
              <input type="text" class="form-control" id="title" name="title" placeholder="e.g. Introduction to Programming" required>
            </div>
          </div>

          <div class="mb-3">
            <label for="description" class="form-label">Course Description / Syllabus</label>
            <textarea class="form-control" id="description" name="description" rows="4" placeholder="Course outline, topics covered, and prerequisites..."></textarea>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-md-4">
              <label for="category" class="form-label">Academic Category</label>
              <input type="text" class="form-control" id="category" name="category" placeholder="e.g. Computer Science" value="Computer Science">
            </div>
            <div class="col-md-4">
              <label for="credits" class="form-label">Credits</label>
              <input type="number" class="form-control" id="credits" name="credits" value="3" min="1" max="10" required>
            </div>
            <div class="col-md-4">
              <label for="status" class="form-label">Initial Status</label>
              <select class="form-select" id="status" name="status">
                <option value="active" selected>Active</option>
                <option value="inactive">Inactive</option>
                <option value="archived">Archived</option>
              </select>
            </div>
          </div>

          <div class="d-flex justify-content-between align-items-center">
            <a href="/admin/courses" class="btn btn-outline-slw">Cancel</a>
            <button type="submit" class="btn btn-primary-slw px-4">Create Course</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
