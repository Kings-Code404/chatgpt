<%- include('../partials/head', { title: 'Exam Results Oversight – Smart Learning' }) %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>

<main class="slw-content">
  <%- include('../partials/flash') %>

  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
      <h1 class="page-title">Exam Results & Attempts Oversight</h1>
      <div class="page-subtitle mb-0">System-wide audit of student exam submissions and objective grading outcomes.</div>
    </div>
  </div>

  <% if (attempts && attempts.length > 0) { %>
    <div class="card-slw overflow-hidden mb-4">
      <div class="table-responsive">
        <table class="table-slw">
          <thead>
            <tr>
              <th>Student Name</th>
              <th>Course</th>
              <th>Exam Title</th>
              <th>Started At</th>
              <th>Score</th>
              <th>Status</th>
              <th class="text-end">Details</th>
            </tr>
          </thead>
          <tbody>
            <% attempts.forEach(att => { %>
              <% const isPass = att.score !== null && att.score >= att.pass_marks; %>
              <tr>
                <td>
                  <div class="fw-semibold"><%= att.student_name %></div>
                  <div class="small text-muted"><%= att.student_email %></div>
                </td>
                <td>
                  <span class="badge-slw badge-primary"><%= att.course_code %></span>
                </td>
                <td class="fw-semibold"><%= att.exam_title %></td>
                <td class="small text-muted"><%= new Date(att.started_at).toLocaleString() %></td>
                <td>
                  <strong><%= att.score !== null ? att.score : '--' %></strong> / <%= att.total_marks %>
                </td>
                <td>
                  <% if (att.status === 'in_progress') { %>
                    <span class="badge-slw badge-warning">In Progress</span>
                  <% } else if (isPass) { %>
                    <span class="badge-slw badge-success">Passed</span>
                  <% } else { %>
                    <span class="badge-slw badge-error">Failed</span>
                  <% } %>
                </td>
                <td class="text-end">
                  <a href="/admin/results/<%= att.id %>" class="btn btn-sm btn-outline-slw py-1 px-2" title="Inspect Full Attempt">
                    <span class="material-symbols-outlined fs-6">visibility</span>
                    <span>Review</span>
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } else { %>
    <div class="card-slw p-5 text-center text-muted">
      <span class="material-symbols-outlined fs-1 mb-2">analytics</span>
      <h2 class="h5">No student attempts recorded in the database</h2>
    </div>
  <% } %>
</main>

<%- include('../partials/footer') %>
