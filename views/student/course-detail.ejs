<%- include('../partials/head', { title: `${course.code} – ${course.title}` }) %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>

<main class="slw-content">
  <%- include('../partials/flash') %>

  <div class="row justify-content-center">
    <div class="col-lg-10">
      <div class="card-slw p-4 p-md-5 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div class="d-flex align-items-center gap-2">
            <span class="badge-slw badge-primary fs-6"><%= course.code %></span>
            <span class="badge-slw badge-neutral"><%= course.category || 'General' %></span>
          </div>
          <% if (isEnrolled) { %>
            <span class="badge-slw badge-success">Enrolled</span>
          <% } %>
        </div>

        <h1 class="page-title mb-2"><%= course.title %></h1>
        
        <div class="d-flex align-items-center gap-4 text-muted small mb-4 flex-wrap">
          <div>
            <span class="material-symbols-outlined fs-6 align-middle">credit_card</span>
            <span><%= course.credits %> Credits</span>
          </div>
          <div>
            <span class="material-symbols-outlined fs-6 align-middle">verified</span>
            <span>Status: <strong class="text-capitalize"><%= course.status %></strong></span>
          </div>
        </div>

        <h2 class="h5 fw-bold mb-2">Syllabus Overview</h2>
        <p class="text-muted mb-4" style="white-space: pre-line;">
          <%= course.description || 'No detailed syllabus has been posted for this course yet.' %>
        </p>

        <!-- Course Teachers -->
        <h2 class="h5 fw-bold mb-3">Assigned Faculty</h2>
        <% if (teachers && teachers.length > 0) { %>
          <div class="row g-3 mb-4">
            <% teachers.forEach(t => { %>
              <div class="col-md-6">
                <div class="p-3 rounded-3 bg-light d-flex align-items-center gap-3">
                  <div class="avatar" style="width: 42px; height: 42px;">
                    <%= t.full_name.charAt(0).toUpperCase() %>
                  </div>
                  <div>
                    <div class="fw-semibold"><%= t.full_name %></div>
                    <div class="small text-muted"><%= t.email %></div>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="text-muted small mb-4">Faculty assignments are currently being updated.</p>
        <% } %>

        <!-- Course Actions for Enrolled Students -->
        <% if (isEnrolled) { %>
          <div class="p-4 rounded-3 bg-light border mb-4">
            <h3 class="h6 fw-bold mb-2">Student Course Options</h3>
            <p class="small text-muted mb-3">You are actively enrolled in this course. Access materials, exams, or leave course feedback.</p>
            <div class="d-flex gap-2 flex-wrap">
              <a href="/student/courses/<%= course.id %>/resources" class="btn btn-primary-slw">
                <span class="material-symbols-outlined fs-6">folder_open</span>
                <span>Access Study Materials (<%= resources ? resources.length : 0 %>)</span>
              </a>
              <a href="/student/feedback/<%= course.id %>/new" class="btn btn-outline-slw">
                <span class="material-symbols-outlined fs-6">rate_review</span>
                <span>Leave Course Feedback</span>
              </a>
              <form action="/student/courses/<%= course.id %>/drop" method="POST" class="d-inline ms-auto" onsubmit="return confirm('Are you sure you want to drop this course?');">
                <button type="submit" class="btn btn-outline-danger">Drop Course</button>
              </form>
            </div>
          </div>
        <% } else { %>
          <div class="p-4 rounded-3 bg-light border mb-4 text-center">
            <h3 class="h6 fw-bold mb-2">Not Enrolled</h3>
            <p class="small text-muted mb-3">Enroll now to access uploaded study materials, assignments, and online exams.</p>
            <form action="/student/courses/<%= course.id %>/enroll" method="POST" class="d-inline">
              <button type="submit" class="btn btn-primary-slw px-4">
                <span class="material-symbols-outlined fs-6">add</span>
                <span>Enroll in Course</span>
              </button>
            </form>
          </div>
        <% } %>

        <div class="d-flex justify-content-between align-items-center">
          <a href="/student/courses" class="btn btn-outline-slw">
            <span class="material-symbols-outlined fs-6">arrow_back</span>
            <span>Back to Catalog</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
