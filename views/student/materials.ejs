<%- include('../partials/head', { title: `Study Materials – ${course.title}` }) %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>

<main class="slw-content">
  <%- include('../partials/flash') %>

  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <span class="badge-slw badge-primary"><%= course.code %></span>
        <h1 class="page-title mb-0">Study Materials</h1>
      </div>
      <div class="page-subtitle mb-0"><%= course.title %></div>
    </div>
    <a href="/student/courses/<%= course.id %>" class="btn btn-outline-slw">
      <span class="material-symbols-outlined fs-6">arrow_back</span>
      <span>Course Details</span>
    </a>
  </div>

  <% if (resources && resources.length > 0) { %>
    <div class="card-slw overflow-hidden">
      <div class="table-responsive">
        <table class="table-slw">
          <thead>
            <tr>
              <th>Document / Resource Title</th>
              <th>Uploaded By</th>
              <th>File Type</th>
              <th>Size</th>
              <th>Date</th>
              <th class="text-end">Download</th>
            </tr>
          </thead>
          <tbody>
            <% resources.forEach(res => { %>
              <tr>
                <td>
                  <div class="d-flex align-items-center gap-2">
                    <span class="material-symbols-outlined text-primary fs-5">description</span>
                    <div>
                      <div class="fw-semibold"><%= res.title %></div>
                      <% if (res.description) { %>
                        <div class="small text-muted"><%= res.description %></div>
                      <% } %>
                    </div>
                  </div>
                </td>
                <td class="small text-muted"><%= res.uploader_name || 'Faculty' %></td>
                <td>
                  <span class="badge-slw badge-neutral small">
                    <%= res.file_type ? res.file_type.split('/').pop().toUpperCase() : 'FILE' %>
                  </span>
                </td>
                <td class="small text-muted">
                  <%= res.file_size ? (res.file_size / (1024 * 1024)).toFixed(2) + ' MB' : '--' %>
                </td>
                <td class="small text-muted">
                  <%= new Date(res.created_at).toLocaleDateString() %>
                </td>
                <td class="text-end">
                  <a href="/student/resources/<%= res.id %>/download" class="btn btn-sm btn-primary-slw py-1 px-3">
                    <span class="material-symbols-outlined fs-6">download</span>
                    <span>Download</span>
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } else { %>
    <div class="card-slw p-5 text-center text-muted">
      <span class="material-symbols-outlined fs-1 mb-2">folder_open</span>
      <h2 class="h5">No study materials uploaded yet</h2>
      <p class="small mb-0">Your course instructor will upload lecture notes, slides, and reference files here.</p>
    </div>
  <% } %>
</main>

<%- include('../partials/footer') %>
