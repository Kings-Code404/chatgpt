<%- include('../partials/head', { title: 'Set New Password – Smart Learning' }) %>

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-logo">
      <img src="/images/logo.png" alt="Smart Learning Logo">
      <div class="auth-title mt-2">New Password</div>
      <div class="auth-subtitle">Choose a new secure password for your account</div>
    </div>

    <%- include('../partials/flash') %>

    <form action="/auth/reset-password/<%= token %>" method="POST">
      <input type="hidden" name="token" value="<%= token %>">

      <div class="mb-3">
        <label for="password" class="form-label">New Password</label>
        <input type="password" class="form-control" id="password" name="password" placeholder="Min. 8 characters" required>
      </div>

      <div class="mb-3">
        <label for="confirm_password" class="form-label">Confirm New Password</label>
        <input type="password" class="form-control" id="confirm_password" name="confirm_password" placeholder="Repeat password" required>
        <div class="form-text small">Must contain at least 8 characters and a number.</div>
      </div>

      <button type="submit" class="btn btn-primary-slw w-100 justify-content-center py-2 mb-3">
        <span>Reset Password</span>
        <span class="material-symbols-outlined fs-5">lock_reset</span>
      </button>

      <div class="text-center small">
        <a href="/auth/login" class="text-muted text-decoration-none">Back to sign in</a>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
