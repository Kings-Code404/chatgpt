<%- include('../partials/head', { title: 'Forgot Password – Smart Learning' }) %>

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-logo">
      <img src="/images/logo.png" alt="Smart Learning Logo">
      <div class="auth-title mt-2">Reset Password</div>
      <div class="auth-subtitle">Enter your registered email to receive reset instructions</div>
    </div>

    <%- include('../partials/flash') %>

    <form action="/auth/forgot-password" method="POST">
      <div class="mb-4">
        <label for="email" class="form-label">Email Address</label>
        <input type="email" class="form-control" id="email" name="email" placeholder="name@institution.edu" required autocomplete="email">
      </div>

      <button type="submit" class="btn btn-primary-slw w-100 justify-content-center py-2 mb-3">
        <span>Send Reset Link</span>
        <span class="material-symbols-outlined fs-5">mail</span>
      </button>

      <div class="text-center small">
        <a href="/auth/login" class="text-muted text-decoration-none d-inline-flex align-items-center gap-1">
          <span class="material-symbols-outlined fs-6">arrow_back</span>
          <span>Back to sign in</span>
        </a>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
