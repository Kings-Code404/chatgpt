<%- include('../partials/head', { title: '500 Server Error – Smart Learning' }) %>
<%- include('../partials/topbar') %>

<div class="container py-5 mt-5 text-center">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card-slw p-5 text-center">
        <span class="material-symbols-outlined text-danger mb-3" style="font-size: 4rem;">warning</span>
        <h1 class="h3 fw-bold mb-2">Something Went Wrong</h1>
        <p class="text-muted mb-4">
          <%= typeof message !== 'undefined' ? message : 'An unexpected error occurred while processing your request.' %>
        </p>
        <div class="d-flex justify-content-center gap-3">
          <a href="javascript:history.back()" class="btn btn-outline-slw">Try Again</a>
          <a href="/" class="btn btn-primary-slw">Home Page</a>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
