<%- include('../partials/head', { title: `Manage Resources – ${course.title}` }) %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>

<main class="slw-content">
  <%- include('../partials/flash') %>

  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <span class="badge-slw badge-primary"><%= course.code %></span>
        <h1 class="page-title mb-0">Study Resources</h1>
      </div>
      <div class="page-subtitle mb-0"><%= course.title %></div>
    </div>
    <div class="d-flex gap-2">
      <a href="/teacher/courses" class="btn btn-outline-slw">
        <span class="material-symbols-outlined fs-6">arrow_back</span>
        <span>My Courses</span>
      </a>
      <button class="btn btn-primary-slw" data-bs-toggle="collapse" data-bs-target="#uploadFormCollapse">
        <span class="material-symbols-outlined fs-6">upload_file</span>
        <span>Upload New Material</span>
      </button>
    </div>
  </div>

  <!-- Collapsible Upload Form -->
  <div class="collapse mb-4" id="uploadFormCollapse">
    <div class="card-slw p-4">
      <h2 class="h5 fw-bold mb-3">Upload Study Resource</h2>
      <form action="/teacher/courses/<%= course.id %>/resources" method="POST" enctype="multipart/form-data">
        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label for="title" class="form-label">Material Title</label>
            <input type="text" class="form-control" id="title" name="title" placeholder="e.g. Chapter 3 - Lecture Slides" required>
          </div>
          <div class="col-md-6">
            <label for="resource_file" class="form-label">Select Document File</label>
            <input type="file" class="form-control" id="resource_file" name="resource_file" required>
            <div class="form-text small">Supported: PDF, Word, PPT, TXT, Images, MP4. Max 10 MB.</div>
          </div>
        </div>

        <div class="mb-3">
          <label for="description" class="form-label">Resource Description / Instructions</label>
          <textarea class="form-control" id="description" name="description" rows="2" placeholder="Brief context or instructions for students..."></textarea>
        </div>

        <div class="d-flex justify-content-end gap-2">
          <button type="button" class="btn btn-outline-slw" data-bs-toggle="collapse" data-bs-target="#uploadFormCollapse">Cancel</button>
          <button type="submit" class="btn btn-primary-slw px-4">
            <span>Upload File</span>
            <span class="material-symbols-outlined fs-6">cloud_upload</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Resources Table -->
  <% if (resources && resources.length > 0) { %>
    <div class="card-slw overflow-hidden">
      <div class="table-responsive">
        <table class="table-slw">
          <thead>
            <tr>
              <th>Title & Description</th>
              <th>Original File Name</th>
              <th>Format</th>
              <th>File Size</th>
              <th>Uploaded Date</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% resources.forEach(res => { %>
              <tr>
                <td>
                  <div class="fw-semibold"><%= res.title %></div>
                  <% if (res.description) { %>
                    <div class="small text-muted"><%= res.description %></div>
                  <% } %>
                </td>
                <td class="small text-muted"><%= res.original_name %></td>
                <td>
                  <span class="badge-slw badge-neutral small">
                    <%= res.file_type ? res.file_type.split('/').pop().toUpperCase() : 'FILE' %>
                  </span>
                </td>
                <td class="small text-muted">
                  <%= res.file_size ? (res.file_size / (1024 * 1024)).toFixed(2) + ' MB' : '--' %>
                </td>
                <td class="small text-muted">
                  <%= new Date(res.created_at).toLocaleDateString() %>
                </td>
                <td class="text-end">
                  <div class="d-inline-flex gap-2">
                    <a href="/student/resources/<%= res.id %>/download" class="btn btn-sm btn-outline-slw py-1 px-2" title="Download">
                      <span class="material-symbols-outlined fs-6">download</span>
                    </a>
                    <button type="button" 
                            class="btn btn-sm btn-outline-danger py-1 px-2" 
                            data-method="delete" 
                            data-action="/teacher/resources/<%= res.id %>"
                            data-confirm="Delete this study material? This cannot be undone."
                            title="Delete Resource">
                      <span class="material-symbols-outlined fs-6">delete</span>
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } else { %>
    <div class="card-slw p-5 text-center text-muted">
      <span class="material-symbols-outlined fs-1 mb-2">folder_open</span>
      <h2 class="h5">No resources uploaded for this course yet</h2>
      <p class="small mb-3">Click the "Upload New Material" button above to publish notes, slides, or documents.</p>
    </div>
  <% } %>
</main>

<%- include('../partials/footer') %>
