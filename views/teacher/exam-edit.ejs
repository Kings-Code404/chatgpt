<%- include('../partials/head', { title: `Edit Exam: ${exam.title}` }) %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>

<main class="slw-content">
  <%- include('../partials/flash') %>

  <div class="row justify-content-center">
    <div class="col-lg-9">
      <div class="card-slw p-4 p-md-5">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <h1 class="page-title mb-0">Edit Examination</h1>
          <a href="/teacher/exams/<%= exam.id %>/questions/new" class="btn btn-sm btn-outline-slw">
            <span class="material-symbols-outlined fs-6">quiz</span>
            <span>Manage Questions</span>
          </a>
        </div>
        <div class="page-subtitle mb-4">Modify scheduling and assessment parameters.</div>

        <form action="/teacher/exams/<%= exam.id %>" method="POST">
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label for="course_id" class="form-label">Course</label>
              <select class="form-select" id="course_id" name="course_id" required>
                <% (courses || []).forEach(c => { %>
                  <option value="<%= c.id %>" <%= exam.course_id === c.id ? 'selected' : '' %>>
                    <%= c.code %> – <%= c.title %>
                  </option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <label for="title" class="form-label">Exam Title</label>
              <input type="text" class="form-control" id="title" name="title" value="<%= exam.title %>" required>
            </div>
          </div>

          <div class="mb-3">
            <label for="description" class="form-label">Exam Instructions / Syllabus Scope</label>
            <textarea class="form-control" id="description" name="description" rows="3"><%= exam.description || '' %></textarea>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-3">
              <label for="duration_minutes" class="form-label">Duration (Minutes)</label>
              <input type="number" class="form-control" id="duration_minutes" name="duration_minutes" value="<%= exam.duration_minutes %>" min="5" max="300" required>
            </div>
            <div class="col-md-3">
              <label for="total_marks" class="form-label">Total Marks</label>
              <input type="number" class="form-control" id="total_marks" name="total_marks" value="<%= exam.total_marks %>" min="1" required>
            </div>
            <div class="col-md-3">
              <label for="pass_marks" class="form-label">Passing Marks</label>
              <input type="number" class="form-control" id="pass_marks" name="pass_marks" value="<%= exam.pass_marks %>" min="1" required>
            </div>
            <div class="col-md-3">
              <label for="attempt_limit" class="form-label">Attempt Limit</label>
              <input type="number" class="form-control" id="attempt_limit" name="attempt_limit" value="<%= exam.attempt_limit %>" min="1" max="10" required>
            </div>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-md-4">
              <label for="start_time" class="form-label">Available From (Optional)</label>
              <input type="datetime-local" class="form-control" id="start_time" name="start_time" value="<%= exam.start_time ? new Date(new Date(exam.start_time).getTime() - (new Date().getTimezoneOffset() * 60000)).toISOString().slice(0, 16) : '' %>">
            </div>
            <div class="col-md-4">
              <label for="end_time" class="form-label">Available Until (Optional)</label>
              <input type="datetime-local" class="form-control" id="end_time" name="end_time" value="<%= exam.end_time ? new Date(new Date(exam.end_time).getTime() - (new Date().getTimezoneOffset() * 60000)).toISOString().slice(0, 16) : '' %>">
            </div>
            <div class="col-md-4">
              <label for="status" class="form-label">Status</label>
              <select class="form-select" id="status" name="status">
                <option value="draft" <%= exam.status === 'draft' ? 'selected' : '' %>>Draft (Hidden)</option>
                <option value="published" <%= exam.status === 'published' ? 'selected' : '' %>>Published (Active)</option>
                <option value="closed" <%= exam.status === 'closed' ? 'selected' : '' %>>Closed (Ended)</option>
              </select>
            </div>
          </div>

          <div class="d-flex justify-content-between align-items-center">
            <a href="/teacher/exams" class="btn btn-outline-slw">Cancel</a>
            <button type="submit" class="btn btn-primary-slw px-4">Save Changes</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
