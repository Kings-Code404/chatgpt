<%- include('../partials/head', { title: `${course.code} – ${course.title}` }) %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>

<main class="slw-content">
  <%- include('../partials/flash') %>

  <div class="row justify-content-center">
    <div class="col-lg-10">
      <div class="card-slw p-4 p-md-5 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div class="d-flex align-items-center gap-2">
            <span class="badge-slw badge-primary fs-6"><%= course.code %></span>
            <span class="badge-slw badge-neutral"><%= course.category || 'General' %></span>
          </div>
          <span class="badge-slw badge-success">Assigned Course</span>
        </div>

        <h1 class="page-title mb-2"><%= course.title %></h1>
        
        <div class="d-flex align-items-center gap-4 text-muted small mb-4 flex-wrap">
          <div>
            <span class="material-symbols-outlined fs-6 align-middle">credit_card</span>
            <span><%= course.credits %> Credits</span>
          </div>
          <div>
            <span class="material-symbols-outlined fs-6 align-middle">verified</span>
            <span>Status: <strong class="text-capitalize"><%= course.status %></strong></span>
          </div>
        </div>

        <h2 class="h5 fw-bold mb-2">Syllabus Overview</h2>
        <p class="text-muted mb-4" style="white-space: pre-line;">
          <%= course.description || 'No detailed syllabus has been posted for this course yet.' %>
        </p>

        <!-- Faculty Actions -->
        <div class="p-4 rounded-3 bg-light border mb-4">
          <h3 class="h6 fw-bold mb-2">Faculty Management Actions</h3>
          <p class="small text-muted mb-3">Distribute course study materials and author online exams for this curriculum.</p>
          <div class="d-flex gap-2 flex-wrap">
            <a href="/teacher/courses/<%= course.id %>/resources" class="btn btn-primary-slw">
              <span class="material-symbols-outlined fs-6">folder_open</span>
              <span>Manage Study Resources (<%= resources ? resources.length : 0 %>)</span>
            </a>
            <a href="/teacher/exams/new" class="btn btn-outline-slw">
              <span class="material-symbols-outlined fs-6">add</span>
              <span>Create Online Exam</span>
            </a>
          </div>
        </div>

        <div class="d-flex justify-content-between align-items-center">
          <a href="/teacher/courses" class="btn btn-outline-slw">
            <span class="material-symbols-outlined fs-6">arrow_back</span>
            <span>Back to Assigned Courses</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
