<%- include('../partials/head', { title: 'Create Examination – Smart Learning' }) %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>

<main class="slw-content">
  <%- include('../partials/flash') %>

  <div class="row justify-content-center">
    <div class="col-lg-9">
      <div class="card-slw p-4 p-md-5">
        <h1 class="page-title mb-1">Create New Examination</h1>
        <div class="page-subtitle mb-4">Set parameters and scheduling for a new course assessment.</div>

        <form action="/teacher/exams" method="POST">
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label for="course_id" class="form-label">Course</label>
              <select class="form-select" id="course_id" name="course_id" required>
                <option value="">Select assigned course...</option>
                <% (courses || []).forEach(c => { %>
                  <option value="<%= c.id %>"><%= c.code %> – <%= c.title %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <label for="title" class="form-label">Exam Title</label>
              <input type="text" class="form-control" id="title" name="title" placeholder="e.g. Mid-Term Assessment" required>
            </div>
          </div>

          <div class="mb-3">
            <label for="description" class="form-label">Exam Instructions / Syllabus Scope</label>
            <textarea class="form-control" id="description" name="description" rows="3" placeholder="Covers Chapters 1-4. Ensure a stable internet connection..."></textarea>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-3">
              <label for="duration_minutes" class="form-label">Duration (Minutes)</label>
              <input type="number" class="form-control" id="duration_minutes" name="duration_minutes" value="60" min="5" max="300" required>
            </div>
            <div class="col-md-3">
              <label for="total_marks" class="form-label">Total Marks</label>
              <input type="number" class="form-control" id="total_marks" name="total_marks" value="50" min="1" required>
            </div>
            <div class="col-md-3">
              <label for="pass_marks" class="form-label">Passing Marks</label>
              <input type="number" class="form-control" id="pass_marks" name="pass_marks" value="20" min="1" required>
            </div>
            <div class="col-md-3">
              <label for="attempt_limit" class="form-label">Attempt Limit</label>
              <input type="number" class="form-control" id="attempt_limit" name="attempt_limit" value="1" min="1" max="10" required>
            </div>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-md-4">
              <label for="start_time" class="form-label">Available From (Optional)</label>
              <input type="datetime-local" class="form-control" id="start_time" name="start_time">
            </div>
            <div class="col-md-4">
              <label for="end_time" class="form-label">Available Until (Optional)</label>
              <input type="datetime-local" class="form-control" id="end_time" name="end_time">
            </div>
            <div class="col-md-4">
              <label for="status" class="form-label">Status</label>
              <select class="form-select" id="status" name="status">
                <option value="draft">Draft (Hidden from students)</option>
                <option value="published" selected>Published (Students can take)</option>
                <option value="closed">Closed (Submissions disabled)</option>
              </select>
            </div>
          </div>

          <div class="d-flex justify-content-between align-items-center">
            <a href="/teacher/exams" class="btn btn-outline-slw">Cancel</a>
            <button type="submit" class="btn btn-primary-slw px-4">
              <span>Save & Add Questions</span>
              <span class="material-symbols-outlined fs-6">arrow_forward</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
