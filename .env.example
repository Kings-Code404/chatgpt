PORT=3000
NODE_ENV=development

# Session Configuration
SESSION_SECRET=replace_with_random_64_character_hex_value

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_database_password
DB_NAME=slwa_db

# File Uploads
MAX_FILE_SIZE_MB=10
# For Render, use the mount path of an attached persistent disk (for example /var/data/uploads).
UPLOAD_DIR=./uploads

# App URL
BASE_URL=http://localhost:3000

# Email (SMTP) Configuration for Password Reset (Optional for dev)
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Smart Learning" <no-reply@smartlearning.com>
